# Copie este archivo como ".env" y complete sus valores.

# --- Django ---
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DB_ENGINE=postgresql
DB_NAME=vision_asistencia
DB_USER=postgres
DB_PASSWORD=su_contraseña_de_postgres
DB_HOST=localhost
DB_PORT=5432

# --- Cámara / visión ---
# 0 = cámara integrada, 1 = cámara USB externa, o ruta a un video / URL RTSP para pruebas.
CAMERA_SOURCE=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
# Distancia LBPH máxima aceptada (menor = más estricto). Rango recomendado: 55-75.
RECOGNITION_THRESHOLD=65
# Muestras de rostro a capturar en el registro guiado.
ENROLL_SAMPLES=30
# Modelo FER+ para detectar emociones (se descarga solo la primera vez si no existe).
EMOTION_MODEL_DOWNLOAD=True
# Segundos sin espectadores antes de apagar la cámara.
IDLE_TIMEOUT=30

# --- Asistencia ---
HORA_LIMITE_PUNTUAL=08:15

# --- Panel /admin (se crea al ejecutar migrate) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin2026!
ADMIN_EMAIL=admin@localhost
